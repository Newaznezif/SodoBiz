# SodoBiz Bridge Environment Configuration (.env.example)

# Supabase Database & Auth (Optional - built-in local database engine used automatically if unconfigured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Privileged Operations (Never expose to client or prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GEMINI_API_KEY: Injected by AI Studio runtime if AI features are configured
GEMINI_API_KEY=MY_GEMINI_API_KEY

# APP_URL: Current hosting URL
APP_URL=http://localhost:3000
